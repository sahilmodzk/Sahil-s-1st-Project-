# Local development only; create separate credentials for production.
DATABASE_URL="postgresql://gather:gather_dev_only@localhost:5432/gather?schema=public"
BETTER_AUTH_URL="http://localhost:3000"
# Replace before starting: openssl rand -hex 32
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"

# Optional locally. Without SMTP, reset links are written to private .local/mail/*.json.
# Production password resets require a working SMTP service and verified sender.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="your-smtp-username"
# SMTP_PASSWORD="your-smtp-password"
# MAIL_FROM="Gather <noreply@example.com>"
